# Copy to server/.env
DATABASE_URL=postgresql://veraglo:veraglo@localhost:5432/veraglo_erp
PORT=3000
CORS_ORIGIN=http://localhost:3000

# Production mode — disables login-screen admin creation; use secured bootstrap instead
# VERAGLO_PRODUCTION=1
# NODE_ENV=production

# One-time Super Admin bootstrap (production first launch)
# BOOTSTRAP_ENABLED=1
# BOOTSTRAP_SECRET=change-me-to-a-long-random-secret
# RECOVERY_SECRET=separate-secret-for-admin-recovery

# Optional bootstrap defaults (CLI or POST /api/system/bootstrap-admin)
# ADMIN_EMAIL=admin@company.com
# ADMIN_PASSWORD=
# ADMIN_NAME=Super Administrator
# ORGANIZATION_NAME=My Company
# VERAGLO_RETURN_BOOTSTRAP_PASSWORD=1

# File storage (desktop / portable / production without Postgres)
# USE_FILE_STORAGE=1
# VERAGLO_DATA_DIR=/path/to/veraglo/data

# Emergency bypass for IP whitelisting (set to 1 only if locked out)
# VERAGLO_IP_BYPASS=1

# AWS RDS: SSL is enabled automatically when the host contains .rds.amazonaws.com
# Or add ?sslmode=require to DATABASE_URL, or set PG_SSL=true
# PG_SSL=true
