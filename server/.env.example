# Copy to server/.env
DATABASE_URL=postgresql://veraglo:veraglo@localhost:5432/veraglo_erp
PORT=3000
CORS_ORIGIN=http://localhost:3000

# Emergency bypass for IP whitelisting (set to 1 only if locked out)
# VERAGLO_IP_BYPASS=1

# AWS RDS: SSL is enabled automatically when the host contains .rds.amazonaws.com
# Or add ?sslmode=require to DATABASE_URL, or set PG_SSL=true
# PG_SSL=true
